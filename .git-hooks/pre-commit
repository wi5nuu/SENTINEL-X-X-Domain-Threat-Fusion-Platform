#!/bin/bash
# Pre-commit hook to prevent sensitive files from being committed

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "Running pre-commit security checks..."

# List of patterns that should NEVER be committed
SENSITIVE_PATTERNS=(
    "\.env$"
    "\.license$"
    "\.license\.enc$"
    "license\.key$"
    "auth\.key$"
    "\.machine_id$"
    "\.fingerprint$"
    "hardware\.lock$"
    "activation\.dat$"
    "\.activation/"
    "config\.secure$"
    "config\.locked$"
    "\.config\.vault$"
    "api_keys\.json$"
    "service_account\.json$"
    "wallet\.dat$"
    "private_keys/"
    "credentials/"
    "\.credentials/"
    "src/common/license_manager\.py$"
    "src/common/hardware_fingerprint\.py$"
    "setup/generate_license\.py$"
    "setup/install_private\.sh$"
    "\.db$"
    "\.sqlite$"
)

# List of content patterns that should never appear in code
FORBIDDEN_CONTENT=(
    "BEGIN PRIVATE KEY"
    "BEGIN RSA PRIVATE KEY"
    "api_key\s*=\s*['\"][a-zA-Z0-9]{20,}['\"]"
    "password\s*=\s*['\"][^'\"]{8,}['\"]"
    "secret\s*=\s*['\"][a-zA-Z0-9]{20,}['\"]"
    "token\s*=\s*['\"][a-zA-Z0-9]{20,}['\"]"
)

BLOCKED_FILES=()
BLOCKED_CONTENT=()

# Check staged files
for file in $(git diff --cached --name-only); do
    # Check file patterns
    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        if echo "$file" | grep -qE "$pattern"; then
            BLOCKED_FILES+=("$file")
            break
        fi
    done
    
    # Check file content (only for text files)
    if [ -f "$file" ]; then
        for pattern in "${FORBIDDEN_CONTENT[@]}"; do
            if grep -qiE "$pattern" "$file" 2>/dev/null; then
                BLOCKED_CONTENT+=("$file: matches pattern '$pattern'")
            fi
        done
    fi
done

# Report blocked files
if [ ${#BLOCKED_FILES[@]} -gt 0 ]; then
    echo -e "${RED}ERROR: Attempting to commit sensitive files!${NC}"
    echo ""
    echo "The following files should NOT be committed:"
    for file in "${BLOCKED_FILES[@]}"; do
        echo -e "  ${RED}✗${NC} $file"
    done
    echo ""
    echo "These files contain sensitive data or proprietary code."
    echo "Add them to .gitignore if not already present."
    echo ""
    exit 1
fi

# Report blocked content
if [ ${#BLOCKED_CONTENT[@]} -gt 0 ]; then
    echo -e "${RED}ERROR: Sensitive content detected in staged files!${NC}"
    echo ""
    echo "The following files contain sensitive data:"
    for item in "${BLOCKED_CONTENT[@]}"; do
        echo -e "  ${RED}✗${NC} $item"
    done
    echo ""
    echo "Remove sensitive data before committing."
    echo "Use environment variables or secure vaults for secrets."
    echo ""
    exit 1
fi

# Check for common mistakes
if git diff --cached --name-only | grep -qE "\.env\."; then
    echo -e "${YELLOW}WARNING: Committing .env.* file${NC}"
    echo "Make sure this is .env.example and not actual credentials!"
fi

echo -e "${GREEN}✓ Security checks passed${NC}"
exit 0
