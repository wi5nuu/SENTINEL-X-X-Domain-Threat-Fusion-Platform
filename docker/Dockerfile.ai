FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev cmake && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-ai.txt requirements-ai.txt
COPY requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements-ai.txt

COPY src/ /app/src/
COPY models/ /app/models/

COPY docker/entrypoint-ai.sh /usr/local/bin/entrypoint-ai.sh
RUN chmod +x /usr/local/bin/entrypoint-ai.sh

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["entrypoint-ai.sh"]
