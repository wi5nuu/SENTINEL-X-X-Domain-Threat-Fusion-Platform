# SENTINEL Configuration - PRODUCTION REAL-TIME MODE

# Security Settings
ENABLE_SYNTHETIC_DATA=false
ENABLE_DATA_ENCRYPTION=true
ENABLE_API_KEY_ROTATION=true
API_KEY_ROTATION_HOURS=24
MAX_API_RATE_LIMIT=1000
ENABLE_REQUEST_SIGNING=true

# Databases (Use strong passwords in production!)
DATABASE_URL=postgresql://sentinel:sentinel_pass@postgres:5432/sentinel
DATABASE_PASSWORD=sentinel_pass
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Blockchain
ETHEREUM_RPC_URL=http://hardhat-node:8545
ETHEREUM_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
IPFS_RPC_URL=http://ipfs:5001

# JWT & Authentication
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENABLE_2FA=false

# AIR DOMAIN - Real-time Aviation Data
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_API_URL=https://opensky-network.org/api
AEROAPI_KEY=
AEROAPI_URL=https://aeroapi.flightaware.com/aeroapi
ADSB_EXCHANGE_API_KEY=
ADSB_EXCHANGE_URL=https://adsbexchange-com1.p.rapidapi.com

# MARITIME DOMAIN - Real-time Vessel Tracking
MARINETRAFFIC_API_KEY=
MARINETRAFFIC_URL=https://services.marinetraffic.com/api
VESSELFINDER_API_KEY=
VESSELFINDER_URL=https://api.vesselfinder.com
AISHUB_USERNAME=
AISHUB_URL=http://data.aishub.net

# CYBER THREAT INTELLIGENCE - Real-time Threat Feeds
OTX_API_KEY=
OTX_API_URL=https://otx.alienvault.com/api/v1
ABUSEIPDB_KEY=
ABUSEIPDB_URL=https://api.abuseipdb.com/api/v2
SHODAN_KEY=
SHODAN_URL=https://api.shodan.io
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_URL=https://www.virustotal.com/api/v3
THREATFOX_API_KEY=
THREATFOX_URL=https://threatfox-api.abuse.ch/api/v1

# SEISMIC DATA - Real-time Earthquake Monitoring
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0
EMSC_API_URL=https://www.seismicportal.eu/fdsnws/event/1

# NASA SPACE WEATHER - Real-time Solar & Space Events
NASA_API_KEY=
NASA_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3
NASA_DONKI_URL=https://api.nasa.gov/DONKI

# WEATHER DATA (for correlation analysis)
OPENWEATHER_API_KEY=
OPENWEATHER_URL=https://api.openweathermap.org/data/2.5

# Enhanced Aviation (Optional - FlightAware)
AEROAPI_KEY=
AEROAPI_URL=https://aeroapi.flightaware.com/aeroapi

# Data Quality & Correlation Settings
ENABLE_DATA_QUALITY_VALIDATION=true
ENABLE_CORRELATION_ENGINE=true
CORRELATION_TIME_WINDOW_SECONDS=300
CORRELATION_SPATIAL_PROXIMITY_KM=500
MIN_DATA_QUALITY_SCORE=0.6
MIN_SEISMIC_QUALITY_SCORE=0.7

# Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# AI Model
MODEL_PATH=/models/threat_fusion_v1.pt

# Monitoring
GRAFANA_PASSWORD=sentinel_admin
ENABLE_TELEMETRY=true
ENABLE_AUDIT_LOGS=true

# Data Retention
DATA_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=365
LOG_RETENTION_DAYS=30
